# Copy to .env.local for local development. Never commit real values.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/SEMA_Website?sslmode=require
ADMIN_PASSWORD=change-me
CONTACT_NOTIFICATION_EMAIL=dahiru@sema.org.so

# Information request emails: confirmation to requester and notification to dahiru@sema.org.so.
# Use a sender authorized by your SMTP provider. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Max admin login attempts per client per 5-minute window before /api/admin/auth
# returns 429. Best-effort, in-memory (see rate limiting note under Analytics).
ADMIN_LOGIN_RATE_LIMIT_PER_5MIN=8

# Legacy static fallback dashboard URLs (used only when the database has no
# published dashboard_embeds rows).
NEXT_PUBLIC_ARCGIS_DASHBOARD_URL=
NEXT_PUBLIC_POWERBI_REPORT_URL=

# --- Analytics ------------------------------------------------------------
ANALYTICS_ENABLED=true
ANALYTICS_SESSION_TIMEOUT_MINUTES=30
ANALYTICS_RAW_EVENT_RETENTION_DAYS=365
ANALYTICS_EVENT_RATE_LIMIT_PER_MINUTE=60

# Read by both the browser (must be NEXT_PUBLIC_) and the server, so the
# 30-day "remember this organization" window stays in sync everywhere.
NEXT_PUBLIC_ANALYTICS_SESSION_TIMEOUT_MINUTES=30
NEXT_PUBLIC_DASHBOARD_ACCESS_REMEMBER_DAYS=30

# --- Dashboard access gate --------------------------------------------
DASHBOARD_ACCESS_RETENTION_DAYS=730
DASHBOARD_ACCESS_CONSENT_VERSION=1.0
DASHBOARD_ACCESS_RATE_LIMIT_PER_HOUR=20

# Optional: lets a scheduled job (e.g. Vercel Cron) call
# /api/admin/retention-cleanup without the admin password. Leave unset to
# require normal admin auth for that endpoint instead.
CRON_SECRET=
