# Copy to .env.local for local development. Never commit real values.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/SEMA_Website?sslmode=require
ADMIN_PASSWORD=change-me
CONTACT_NOTIFICATION_EMAIL=mainoffice@sema.org.so

# Information request emails: confirmation to requester and notification to mainoffice@sema.org.so.
# Use a sender authorized by your SMTP provider. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Max admin login attempts per client per 5-minute window before /api/admin/auth
# returns 429. Shared PostgreSQL limits; apply db/migrations/004_security.sql first.
ADMIN_LOGIN_RATE_LIMIT_PER_5MIN=8

# Optional independent key for hashing rate-limit identities; defaults to ADMIN_PASSWORD.
SECURITY_HASH_SECRET=
# Non-Vercel only: set after verifying your reverse proxy OVERWRITES this header
# with the real client IP and direct access to Node is blocked. Unset uses a shared
# "unknown" bucket. Never enable this for a header forwarded unchanged from clients.
TRUSTED_PROXY_IP_HEADER=
# Set to cloudflare only behind a verified Cloudflare-only ingress that overwrites
# CF-IPCountry. Otherwise non-Vercel visitor geography remains unavailable.
TRUSTED_PROXY_GEO_PROVIDER=

# Legacy static fallback dashboard URLs (used only when the database has no
# published dashboard_embeds rows).
NEXT_PUBLIC_ARCGIS_DASHBOARD_URL=
NEXT_PUBLIC_POWERBI_REPORT_URL=

# SEMA IMSMA Core credentials, server-side only. Shared by two features:
#  - app/api/dashboards/nts-coverage/route.ts (Survey Coverage Dashboard,
#    public/dashboards/nts-coverage.html) - live today.
#  - lib/imsma-sync.ts (IMSMA -> Data Catalogue sync) - present in the
#    codebase but not yet fully wired up; its placeholder field names
#    (Region/District/Date_Reported) don't match IMSMA's real schema and
#    need updating once someone picks that feature back up.
# Never exposed to the browser. Same account used by the NTS Area
# Prioritization Tool (C:\NTS Tool\backend\.env) - ask IM for a dedicated
# read-only account if either feature goes into heavier production use.
IMSMA_ARCGIS_USERNAME=
IMSMA_ARCGIS_PASSWORD=
# Full generateToken endpoint, not just the portal root (imsma-sync.ts's own
# default here points at arcgis.com, which is wrong for SEMA's on-prem
# Enterprise portal - always set this explicitly).
IMSMA_ARCGIS_PORTAL_URL=https://so.imsma.org/portal/sharing/rest/generateToken
IMSMA_TOKEN_EXPIRATION_MINUTES=60

# --- Analytics ------------------------------------------------------------
ANALYTICS_ENABLED=true
ANALYTICS_SESSION_TIMEOUT_MINUTES=30
ANALYTICS_RAW_EVENT_RETENTION_DAYS=365
ANALYTICS_EVENT_RATE_LIMIT_PER_MINUTE=60

# Read by both the browser (must be NEXT_PUBLIC_) and the server, so the
# 30-day "remember this organization" window stays in sync everywhere.
NEXT_PUBLIC_ANALYTICS_SESSION_TIMEOUT_MINUTES=30
NEXT_PUBLIC_DASHBOARD_ACCESS_REMEMBER_DAYS=30

# --- Dashboard access gate --------------------------------------------
DASHBOARD_ACCESS_RETENTION_DAYS=730
DASHBOARD_ACCESS_CONSENT_VERSION=1.0
DASHBOARD_ACCESS_RATE_LIMIT_PER_HOUR=20

# Optional: lets a scheduled job (e.g. Vercel Cron) call
# GET /api/admin/retention-cleanup. Browser admins use POST with a valid session.
# Leave unset to disable the scheduled GET path. Schedule daily cleanup to expire
# old analytics, access records, rate-limit buckets and admin sessions.
CRON_SECRET=
